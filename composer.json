{
  "name": "gexo/php-image-editor",
  "type": "library",
  "description": "PHP library to easily edit image with GD extension. Maintained fork of dantsu/php-image-editor with PHP 8.1 - 8.5 support.",
  "keywords": [
    "php",
    "gd2",
    "edit",
    "edition",
    "editor",
    "image",
    "picture",
    "photo"
  ],
  "homepage": "https://github.com/gexo/php-image-editor",
  "license": "MIT",
  "authors": [
    {
      "name": "Franck ALARY",
      "homepage": "https://github.com/DantSu",
      "role": "Original author"
    },
    {
      "name": "Stefan Oswald",
      "homepage": "https://github.com/gexo",
      "role": "Fork maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/gexo/php-image-editor/issues",
    "source": "https://github.com/gexo/php-image-editor"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "replace": {
    "dantsu/php-image-editor": "self.version"
  },
  "autoload": {
    "psr-4": {
      "DantSu\\PHPImageEditor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DantSu\\PHPImageEditor\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
